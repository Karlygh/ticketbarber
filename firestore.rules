rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: comprueba si el usuario tiene uid coincidente ──────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Sesión de dispositivo (TV) ────────────────────────────────────────
    // La TV se autentica de forma anónima y registra su sesión en
    // device_sessions/{uid}. Esto permite autorizar sus lecturas contra un
    // vínculo real en lugar de abrir la cola al público, que expondría
    // nombre y teléfono de los clientes (RGPD art. 5.1.f / ENS mp.info.1).
    function deviceSession() {
      return get(/databases/$(database)/documents/device_sessions/$(request.auth.uid)).data;
    }

    function boundDevice() {
      return get(/databases/$(database)/documents/devices/$(deviceSession().deviceId)).data;
    }

    // Se revalida el dispositivo en cada lectura, no solo al vincularlo: de
    // lo contrario, revocar una TV dejaría su sesión leyendo la cola
    // indefinidamente (ENS op.acc.5.5).
    function isBoundDevice(shopId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/device_sessions/$(request.auth.uid))
             && deviceSession().userId == shopId
             && exists(/databases/$(database)/documents/devices/$(deviceSession().deviceId))
             && boundDevice().userId == shopId
             && boundDevice().anonUid == request.auth.uid
             && boundDevice().revokedAt == 0
             && boundDevice().active == true;
    }

    // Puede ver los datos de una tienda: su dueño o una TV vinculada a ella.
    function canViewShop(shopId) {
      return isOwner(shopId) || isBoundDevice(shopId);
    }

    function isCodeInactive() {
      return resource.data.expiresAt <= request.time.toMillis()
             || resource.data.consumedAt > 0
             || resource.data.revokedAt > 0;
    }

    // Una TV en proceso de vinculación: sesión anónima, nunca una cuenta staff.
    function isAnonymousSession() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function canRedeemPairingCode(codeId) {
      return isAnonymousSession()
             && resource.data.user_code == codeId
             && resource.data.expiresAt > request.time.toMillis()
             && resource.data.consumedAt == 0
             && resource.data.revokedAt == 0
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.user_code == resource.data.user_code
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.expiresAt == resource.data.expiresAt
             && request.resource.data.revokedAt == resource.data.revokedAt
             && request.resource.data.consumedAt > 0
             && request.resource.data.deviceId is string
             && request.resource.data.deviceId.size() > 0;
    }

    function canCreateDeviceFromCode(deviceId) {
      return isAnonymousSession()
             && request.resource.data.deviceId == deviceId
             && request.resource.data.activationCode is string
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.userId == request.resource.data.userId
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.deviceId == deviceId
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.consumedAt > 0
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.revokedAt == 0
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.expiresAt > request.time.toMillis();
    }

    function isActiveDevice() {
      return (!('active' in resource.data) || resource.data.active == true)
             && (!('revokedAt' in resource.data) || resource.data.revokedAt == 0);
    }

    function canUpdateDeviceHeartbeat(deviceId) {
      return isAnonymousSession()
             && request.resource.data.deviceId == deviceId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
             && request.resource.data.lastSeen is number
             && request.resource.data.lastSeen >= resource.data.lastSeen
             && request.resource.data.lastSeen <= request.time.toMillis()
             && isActiveDevice();
    }

    // Re-vinculación tras rotar la sesión anónima (navegador limpiado, TV
    // reiniciada). Solo cambia anonUid y exige conocer el deviceId.
    function canRebindDeviceSession(deviceId) {
      return isAnonymousSession()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anonUid'])
             && request.resource.data.anonUid == request.auth.uid
             && isActiveDevice();
    }

    // ── Perfil del usuario ─────────────────────────────────────────────────
    // Solo el propio usuario puede leer/actualizar su perfil.
    // La creación se hace desde el backend (AuthStore) justo después del login.
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;

      // ── Registro de accesos (ENS op.acc.5.r5.1) ─────────────────────────
      // Solo se puede añadir y consultar. No se permite modificar ni borrar
      // eventos ya registrados: un registro alterable no sirve como
      // evidencia (ENS op.exp.8).
      match /auth_events/{eventId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // ── Colecciones gestionadas por la extensión "Run Payments with Stripe"
    // IMPORTANTE: NUNCA permitas que el frontend escriba en subscriptions,
    // products ni prices. Solo la Cloud Function (extensión) puede hacerlo.
    // ──────────────────────────────────────────────────────────────────────

    match /customers/{userId} {
      // Solo el propietario puede leer sus datos de cliente Stripe
      allow read: if isOwner(userId);
      // La extensión escribe aquí: no permitimos escritura desde el cliente
      allow write: if false;

      // checkout_sessions: el cliente crea/actualiza el documento, la extensión lee/escribe
      match /checkout_sessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      // subscriptions: solo lectura del propietario; escritura exclusiva de la extensión
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // payments: solo lectura del propietario
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ── Productos y precios de Stripe (catálogo público de solo lectura) ──
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Tienda (shop) ──────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if canViewShop(shopId);
      // Solo el propietario puede crear/actualizar el perfil del negocio
      allow create, update: if isOwner(shopId);
      allow delete: if false;

      match /barbers/{barberId} {
        allow read: if canViewShop(shopId);
        allow write: if isOwner(shopId);
      }

      match /settings/{document=**} {
        allow read: if canViewShop(shopId);
        allow write: if isOwner(shopId);
      }

      match /services/{document=**} {
        allow read: if canViewShop(shopId);
        allow write: if isOwner(shopId);
      }

      // Contienen datos personales de clientes finales (nombre y teléfono):
      // nunca deben ser legibles ni creables de forma anónima.
      // El kiosco opera dentro de la sesión del propietario.
      match /tickets/{ticketId} {
        allow read:   if canViewShop(shopId);
        allow create: if isOwner(shopId);
        allow update: if isOwner(shopId);
        allow delete: if isOwner(shopId);
      }

      match /queue/{document=**} {
        allow read:  if canViewShop(shopId);
        allow write: if isOwner(shopId);
      }
    }

    // ── Códigos de vinculación TV (temporales, 15 min) ────────────────────
    match /device_codes/{codeId} {
      // El barbero autenticado genera o reutiliza códigos temporales.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.user_code == codeId
                    && request.resource.data.expiresAt > request.time.toMillis();
      // Ya no es público: exige sesión (la TV abre una anónima antes de
      // canjear). El código sigue siendo el secreto que hay que conocer.
      allow read:   if request.auth != null;
      allow update: if (
                      request.auth != null
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.user_code == codeId
                    ) || (
                      request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.user_code == codeId
                      && isCodeInactive()
                    ) || canRedeemPairingCode(codeId);
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Dispositivos vinculados (permanentes) ─────────────────────────────
    match /devices/{deviceId} {
      // La TV conoce un identificador aleatorio y valida su propio vínculo
      // desde una sesión anónima. Ya no se expone a peticiones sin sesión.
      allow get: if isAnonymousSession()
                 || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list, delete: if request.auth != null
                         && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    || canCreateDeviceFromCode(deviceId);
      // canCreateDeviceFromCode también se admite aquí: si el documento ya
      // existía (TV re-vinculada, o la misma prueba repetida), Firestore
      // trata el set() de redeemCode() como un update, no un create.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    || canUpdateDeviceHeartbeat(deviceId)
                    || canRebindDeviceSession(deviceId)
                    || canCreateDeviceFromCode(deviceId);
    }

    // ── Sesión activa de cada dispositivo TV ──────────────────────────────
    // Índice inverso anonUid -> tienda, para que las reglas de lectura de la
    // cola puedan resolver el vínculo con un único get().
    match /device_sessions/{sessionUid} {
      allow read, delete: if request.auth != null && request.auth.uid == sessionUid;
      allow create, update: if request.auth != null
                    && request.auth.uid == sessionUid
                    && request.resource.data.deviceId is string
                    && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
                    // Solo se puede declarar un vínculo que realmente exista,
                    // pertenezca a esa tienda y no esté revocado.
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.userId == request.resource.data.userId
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.anonUid == request.auth.uid
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.revokedAt == 0;
    }

    // ── Contactos (formulario de contacto) ────────────────────────────────
    // Solo Cloud Functions puede escribir en esta colección.
    // Los usuarios no pueden leer ni escribir directamente.
    // Solo admin desde Firebase Console puede leer.
    match /contactos/{contactId} {
      allow read: if false;  // Solo admin desde Console
      allow write: if false; // Solo Cloud Functions (server-side)
    }

    // ── Motivos de cancelación de suscripción ────────────────────────────
    // El propietario escribe al cancelar; nadie puede leer desde el cliente.
    match /cancellation_feedback/{userId} {
      allow create, update: if isOwner(userId);
      allow read, delete: if false;
    }

    // ── Denegar todo lo demás por defecto ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

