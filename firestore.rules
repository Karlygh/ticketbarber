rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Tienda (shop) - solo lectura pública
    match /shops/{shopId} {
      allow read: if true;
      
      // Configuración de la tienda - solo lectura
      match /settings/{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Servicios - solo lectura
      match /services/{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Tickets - crear sin autenticación, leer y actualizar solo personal
      match /tickets/{ticketId} {
        allow create: if true;
        allow read: if true;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      
      // Cola - solo lectura para kiosco
      match /queue/{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    // Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
