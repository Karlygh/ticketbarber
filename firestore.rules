rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: comprueba si el usuario tiene uid coincidente ──────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCodeInactive() {
      return resource.data.expiresAt <= request.time.toMillis()
             || resource.data.consumedAt > 0
             || resource.data.revokedAt > 0;
    }

    function canRedeemPairingCode(codeId) {
      return request.auth == null
             && resource.data.user_code == codeId
             && resource.data.expiresAt > request.time.toMillis()
             && resource.data.consumedAt == 0
             && resource.data.revokedAt == 0
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.user_code == resource.data.user_code
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.expiresAt == resource.data.expiresAt
             && request.resource.data.revokedAt == resource.data.revokedAt
             && request.resource.data.consumedAt > 0
             && request.resource.data.deviceId is string
             && request.resource.data.deviceId.size() > 0;
    }

    function canCreateDeviceFromCode(deviceId) {
      return request.auth == null
             && request.resource.data.deviceId == deviceId
             && request.resource.data.activationCode is string
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.userId == request.resource.data.userId
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.deviceId == deviceId
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.consumedAt > 0
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.revokedAt == 0
             && getAfter(/databases/$(database)/documents/device_codes/$(request.resource.data.activationCode)).data.expiresAt > request.time.toMillis();
    }

    // ── Perfil del usuario ─────────────────────────────────────────────────
    // Solo el propio usuario puede leer/actualizar su perfil.
    // La creación se hace desde el backend (AuthStore) justo después del login.
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;
    }

    // ── Colecciones gestionadas por la extensión "Run Payments with Stripe"
    // IMPORTANTE: NUNCA permitas que el frontend escriba en subscriptions,
    // products ni prices. Solo la Cloud Function (extensión) puede hacerlo.
    // ──────────────────────────────────────────────────────────────────────

    match /customers/{userId} {
      // Solo el propietario puede leer sus datos de cliente Stripe
      allow read: if isOwner(userId);
      // La extensión escribe aquí: no permitimos escritura desde el cliente
      allow write: if false;

      // checkout_sessions: el cliente crea/actualiza el documento, la extensión lee/escribe
      match /checkout_sessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      // subscriptions: solo lectura del propietario; escritura exclusiva de la extensión
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // payments: solo lectura del propietario
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ── Productos y precios de Stripe (catálogo público de solo lectura) ──
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /prices/{priceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Tienda (shop) ──────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;
      // Solo el propietario puede crear/actualizar el perfil del negocio
      allow create, update: if isOwner(shopId);
      allow delete: if false;

      match /barbers/{barberId} {
        allow read: if true;
        allow write: if isOwner(shopId);
      }

      match /settings/{document=**} {
        allow read: if true;
        allow write: if isOwner(shopId);
      }

      match /services/{document=**} {
        allow read: if true;
        allow write: if isOwner(shopId);
      }

      match /tickets/{ticketId} {
        allow create: if true;
        allow read:   if true;
        allow update: if isOwner(shopId);
        allow delete: if isOwner(shopId);
      }

      match /queue/{document=**} {
        allow read:  if true;
        allow write: if isOwner(shopId);
      }
    }

    // ── Códigos de vinculación TV (temporales, 15 min) ────────────────────
    match /device_codes/{codeId} {
      // El barbero autenticado genera o reutiliza códigos temporales.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.user_code == codeId
                    && request.resource.data.expiresAt > request.time.toMillis();
      allow read:   if true;
      allow update: if (
                      request.auth != null
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.user_code == codeId
                    ) || (
                      request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.user_code == codeId
                      && isCodeInactive()
                    ) || canRedeemPairingCode(codeId);
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Dispositivos vinculados (permanentes) ─────────────────────────────
    match /devices/{deviceId} {
      // Solo el propietario puede leer, crear, actualizar y eliminar
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    || canCreateDeviceFromCode(deviceId);
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Contactos (formulario de contacto) ────────────────────────────────
    // Solo Cloud Functions puede escribir en esta colección.
    // Los usuarios no pueden leer ni escribir directamente.
    // Solo admin desde Firebase Console puede leer.
    match /contactos/{contactId} {
      allow read: if false;  // Solo admin desde Console
      allow write: if false; // Solo Cloud Functions (server-side)
    }

    // ── Motivos de cancelación de suscripción ────────────────────────────
    // El propietario escribe al cancelar; nadie puede leer desde el cliente.
    match /cancellation_feedback/{userId} {
      allow create, update: if isOwner(userId);
      allow read, delete: if false;
    }

    // ── Denegar todo lo demás por defecto ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

